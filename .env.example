RUSTFS_ENDPOINT_URL=http://rustfs:9000
RUSTFS_PUBLIC_ENDPOINT_URL=http://localhost:9000
RUSTFS_BUCKET=prismon
RUSTFS_REGION=us-east-1
RUSTFS_PRESIGNED_URL_TTL_SECONDS=3600
RUSTFS_UPLOAD_EXPIRATION_GRACE_SECONDS=600
RUSTFS_WEBHOOK_AUTH_TOKEN=replace-with-a-long-random-token
RUSTFS_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

API_KEY_KEK=

PASSWORD_PEPPER=pepper

JWT_SECRET_KEY=secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=15

